# Base de la API. En Vercel ponlo a "/api" (funciones serverless en el mismo
# dominio → R2 para ficheros, Neon para pedidos/catálogo). Vacío = modo local
# (IndexedDB + localStorage, un solo navegador) para desarrollo/demo sin backend.
VITE_API_BASE=

# --- Solo en el SERVIDOR (Vercel Environment Variables), nunca con prefijo VITE_ ---
# Estas NO van en el bundle del cliente. Las leen las funciones de /api.
#   R2_ACCESS_KEY_ID=...        (secreto del token R2)
#   R2_SECRET_ACCESS_KEY=...    (secreto del token R2)
#   R2_ACCOUNT_ID=...           (opcional; por defecto el del proyecto)
#   R2_BUCKET=copyvending       (opcional)
#   DATABASE_URL=...            (la añade sola la integración de Neon)
#
# --- OBLIGATORIAS: acceso al backoffice y al mostrador (solo SERVIDOR) ---
# Sin ADMIN_PASSWORD el panel de administración NO se abre (falla cerrado) y la
# API rechaza las operaciones de administración con 503. No hay modo "abierto".
#   ADMIN_PASSWORD=...          (contraseña del backoffice; imprescindible)
#   ADMIN_SECRET=...            (opcional; clave para firmar los tokens. Si no se
#                                pone se usa ADMIN_PASSWORD, así que es mejor
#                                definirla aparte y con valor aleatorio largo.
#                                También firma las capacidades de los ficheros en
#                                R2: si la cambias, los tokens de proyectos ya
#                                creados dejan de valer.)
#   FILE_SECRET=...             (OPCIONAL. Clave para las capacidades de acceso a
#                                los ficheros de R2. Si no se pone se usa
#                                ADMIN_SECRET, que funciona igual; ponerla solo
#                                desacopla la revocación: así rotar la contraseña
#                                del backoffice no invalida los ficheros de los
#                                pedidos ya hechos. ⚠️ Definirla o cambiarla
#                                invalida las capacidades ya emitidas: mejor
#                                hacerlo ahora, con pocos pedidos, que más tarde.)
#   COUNTER_PASSWORD=...        (contraseña del mostrador: la tablet de la
#                                papelería se vincula una vez con ella. Es lo que
#                                demuestra al servidor que el pedido se hace en la
#                                tienda y le corresponde la tarifa de mostrador.
#                                Sin ella, /papeleria.html no se puede activar y
#                                todo pedido se cobra a precio de web.)
#
# --- Conservación de archivos de clientes (opcional) ---
# Los documentos y las miniaturas de un pedido se borran del almacenamiento cuando
# el pedido está terminado (listo, entregado o enviado) y ha pasado este nº de días.
# EL PEDIDO NO SE BORRA: se conserva como registro de venta (las estadísticas, el
# resumen fiscal y el recuento de cupones salen de ahí). Es a la vez ahorro de
# almacenamiento y obligación de RGPD: no guardar documentos ajenos para siempre.
#   FILE_RETENTION_DAYS=10      (por defecto 10)
#
# --- Límite de uso de los endpoints de IA (opcional) ---
#   LLM_RATE_MAX=30             (peticiones por IP cada 10 min; por defecto 30)
#
# --- Disparo programado de la ingesta de email (opcional) ---
# /api/ingest-email exige credenciales de la tienda: el token de admin (que ya
# lleva el backoffice) o este secreto como Bearer. Solo hace falta si algún día
# se programa un cron que lea el buzón sin que nadie abra el panel.
#   CRON_SECRET=...             (aleatorio y largo)
#
# --- Email transaccional (solo SERVIDOR). Ver docs/email.md ---
# Sin estas variables se sigue usando Gmail SMTP (funciona, pero tope ~500/día,
# firma como Gmail y no corre en Cloudflare Workers).
#   MAIL_PROVIDER=brevo         (brevo | resend)
#   MAIL_API_KEY=...            (clave del proveedor)
#   MAIL_FROM=pedidos@tudominio.es   (remitente; con Brevo puede ser un remitente
#                                     individual verificado, sin tener dominio)
#   MAIL_FROM_NAME=Fotocopiator (nombre que ve el cliente)
#   MAIL_REPLY_TO=...           (opcional; buzón que lee una persona)
#
# Alternativa sin proveedor nuevo: usar el SMTP de tu propio hosting de correo
# (el del dominio que ya pagas). Vale como paso intermedio, pero tiene límites de
# envío no documentados, no da seguimiento de rebotes y NO funciona en Cloudflare
# Workers. Si no defines SMTP_HOST se usa Gmail, como antes.
#   SMTP_HOST=smtp.tudominio.es
#   SMTP_PORT=587               (465 = TLS directo, 587 = STARTTLS)
#   SMTP_USER=pedidos@fotocopiator.es
#   SMTP_PASSWORD=...
#
# --- Ingesta por email (/api/ingest-email), solo SERVIDOR ---
# Buzón del que se leen los pedidos. Ya NO tiene que ser Gmail: si tienes correo
# en tu propio dominio (p. ej. pedidos@fotocopiator.es), apúntalo aquí.
#   IMAP_HOST=imap.tudominio.es            (por defecto imap.gmail.com)
#   IMAP_PORT=993                          (por defecto 993)
#   IMAP_USER=pedidos@fotocopiator.es      (por defecto GMAIL_USER)
#   IMAP_PASSWORD=...                      (por defecto GMAIL_APP_PASSWORD)
# Compatibilidad con la configuración anterior (Gmail):
#   GMAIL_USER=copyvending@gmail.com       (la cuenta del buzón; modificable)
#   GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx     (contraseña de aplicación, 16 car.)
#   PUBLIC_URL=https://copyvending.vercel.app  (opcional; enlaces de respuesta/acceso a cuenta)
#   SHOP_NAME=Copistería                   (opcional; nombre en emails y en la factura/pago)
#
# --- Pago online Redsys (/api/pago-redsys, /api/redsys-notify), solo SERVIDOR ---
#   REDSYS_MERCHANT_CODE=326276474         (código de comercio / FUC)
#   REDSYS_TERMINAL=001                    (nº de terminal)
#   REDSYS_SECRET=...                      (clave de firma; NUNCA en el repo)
#   REDSYS_ENV=test                        (test | prod)
#
# --- Asistente IA (/api/assistant), solo SERVIDOR ---
#   GROQ_API_KEY=...            (gratis en console.groq.com)
# Provider-agnostic (opcionales, para cambiar de modelo sin tocar código):
#   LLM_BASE_URL=...            (por defecto https://api.groq.com/openai/v1)
#   LLM_API_KEY=...             (por defecto GROQ_API_KEY)
#   LLM_MODEL=...               (por defecto llama-3.3-70b-versatile)
#   STT_MODEL=...               (transcripción de voz; por defecto whisper-large-v3-turbo)
